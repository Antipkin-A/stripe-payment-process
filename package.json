{
  "name": "stripe-payment-test",
  "version": "1.0.0",
  "description": "Stripe payment integration with setup and payment flows",
  "main": "server.js",
  "scripts": {
    "clean": "rimraf ./public/bundle.js",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js --mode development",
    "client": "webpack serve --mode development",
    "client:build": "webpack --mode production",
    "server:prod": "node server.js --mode production",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "webpack --mode production"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^2.2.0",
    "body-parser": "^1.20.2",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.5",
    "rimraf": "^4.4.1",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "yargs": "^17.7.2"
  }
}
